    "item": [
        {
            "name": "Auth",
            "description": "Authentication endpoints — register, login, get current user, refresh token, and logout.",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstName\": \"Swarup\",\n  \"lastName\": \"Das\",\n  \"email\": \"swarup@example.com\",\n  \"password\": \"secret@123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "register"]
                        },
                        "description": "Register a new customer account.\n\n**Sets cookies:** `accessToken` (1 day) and `refreshToken` (1 year) as `httpOnly` cookies.\n\n**Returns:** `{ id: number }`\n\n**Validation rules:**\n- `firstName` – required\n- `lastName` – required\n- `email` – required, valid email format\n- `password` – required, min 8 characters"
                    },
                    "response": [
                        {
                            "name": "201 Created",
                            "originalRequest": {
                                "method": "POST",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"firstName\": \"Swarup\",\n  \"lastName\": \"Das\",\n  \"email\": \"swarup@example.com\",\n  \"password\": \"secret@123\"\n}"
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/auth/register"
                                }
                            },
                            "status": "Created",
                            "code": 201,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"id\": 1\n}"
                        },
                        {
                            "name": "400 Validation Error",
                            "originalRequest": {
                                "method": "POST",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"email\": \"not-an-email\"\n}"
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/auth/register"
                                }
                            },
                            "status": "Bad Request",
                            "code": 400,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"errors\": [\n    { \"type\": \"field\", \"msg\": \"First name is required!\", \"path\": \"firstName\", \"location\": \"body\" }\n  ]\n}"
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"swarup@example.com\",\n  \"password\": \"secret@123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "login"]
                        },
                        "description": "Authenticate a user and receive `accessToken` and `refreshToken` cookies.\n\n**Sets cookies:** `accessToken` (1 day) and `refreshToken` (1 year) as `httpOnly` cookies.\n\n**Returns:** `{ id: number }`\n\n**Validation rules:**\n- `email` – required, valid email\n- `password` – required"
                    },
                    "response": [
                        {
                            "name": "200 OK",
                            "originalRequest": {
                                "method": "POST",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"email\": \"swarup@example.com\",\n  \"password\": \"secret@123\"\n}"
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/auth/login"
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"id\": 1\n}"
                        },
                        {
                            "name": "400 Invalid Credentials",
                            "originalRequest": {
                                "method": "POST",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"email\": \"swarup@example.com\",\n  \"password\": \"wrongpassword\"\n}"
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/auth/login"
                                }
                            },
                            "status": "Bad Request",
                            "code": 400,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"errors\": [\n    { \"type\": \"UnauthorizedError\", \"message\": \"Email or password does not match.\" }\n  ]\n}"
                        }
                    ]
                },
                {
                    "name": "Get Current User (Self)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/self",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "self"]
                        },
                        "description": "Returns the profile of the currently authenticated user.\n\n**Auth required:** `accessToken` cookie (set on login/register).\n\n**Returns:** User object (password field omitted)."
                    },
                    "response": [
                        {
                            "name": "200 OK",
                            "originalRequest": {
                                "method": "GET",
                                "url": {
                                    "raw": "{{baseUrl}}/auth/self"
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"id\": 1,\n  \"firstName\": \"Swarup\",\n  \"lastName\": \"Das\",\n  \"email\": \"swarup@example.com\",\n  \"role\": \"customer\",\n  \"tenant\": null,\n  \"createdAt\": \"2024-01-01T00:00:00.000Z\",\n  \"updatedAt\": \"2024-01-01T00:00:00.000Z\"\n}"
                        },
                        {
                            "name": "401 Unauthorized",
                            "originalRequest": {
                                "method": "GET",
                                "url": {
                                    "raw": "{{baseUrl}}/auth/self"
                                }
                            },
                            "status": "Unauthorized",
                            "code": 401,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"errors\": [\n    { \"type\": \"UnauthorizedError\", \"message\": \"No authorization token was found\" }\n  ]\n}"
                        }
                    ]
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/refresh",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "refresh"]
                        },
                        "description": "Rotate tokens — exchange the existing `refreshToken` cookie for a new `accessToken` and `refreshToken`.\n\n**Auth required:** `refreshToken` cookie.\n\n**Behavior:** Deletes the old refresh token from the database and creates a new one (token rotation).\n\n**Returns:** `{ id: number }`"
                    },
                    "response": [
                        {
                            "name": "200 OK",
                            "originalRequest": {
                                "method": "POST",
                                "url": {
                                    "raw": "{{baseUrl}}/auth/refresh"
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n  \"id\": 1\n}"
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "logout"]
                        },
                        "description": "Log out the current user.\n\n**Auth required:** `accessToken` cookie (and `refreshToken` cookie to delete the persisted token).\n\n**Behavior:** Deletes the refresh token from the database and clears both `accessToken` and `refreshToken` cookies.\n\n**Returns:** `{}`"
                    },
                    "response": [
                        {
                            "name": "200 OK",
                            "originalRequest": {
                                "method": "POST",
                                "url": {
                                    "raw": "{{baseUrl}}/auth/logout"
                                }
                            },
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{}"
                        }
                    ]
                }
            ]
        },
